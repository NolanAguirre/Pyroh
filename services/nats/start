#!/bin/sh
set -e
cd -- "$(dirname "$0")"
case "${PORT:-}" in
    ''|*[!0-9]*)
        echo 'error: PORT must come from the allocated env-dir configuration' >&2
        exit 1
        ;;
esac
if [ "${#PORT}" -gt 5 ] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo 'error: PORT must be between 1 and 65535' >&2
    exit 1
fi
case "${HOST:-}" in
    ''|*[!a-zA-Z0-9.-]*)
        echo 'error: HOST must be an IPv4 address or hostname' >&2
        exit 1
        ;;
esac
: "${HOME:?HOME must be set for JetStream storage}"
repo_root=$(cd ../.. && pwd -P)
repo=${repo_root##*/}
store_dir="$HOME/.$repo/jetstream"
umask 077
mkdir -p -- "$store_dir"
exec nats-server --addr "$HOST" --port "$PORT" --jetstream --store_dir "$store_dir"
