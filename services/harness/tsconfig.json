{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "rootDir": "src",
    "outDir": "dist/types",
    "declaration": true
  },
  "include": [
    "src/sdk/**/*.ts",
    "src/registry/**/*.ts",
    "src/plugins/**/*.ts",
    "src/config.ts"
  ]
}
