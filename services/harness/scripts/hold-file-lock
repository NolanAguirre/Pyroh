#!/bin/sh

control=$1
status=$2
lock_file=$3
shift 3

# Open in the same order as the caller so neither FIFO needs a dummy writer.
exec 0< "$control"
exec 1> "$status"

# The lock lives in this command until every inherited control writer closes.
# Keep stdout open for the caller to wait for release after closing its writer.
s6-setlock "$@" -d 3 "$lock_file" /bin/sh -c '
printf "0\n"
exec cat > /dev/null
'
result=$?
printf '%s\n' "$result"
