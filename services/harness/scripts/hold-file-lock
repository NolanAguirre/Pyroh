#!/bin/sh

control=$1
status=$2
lock_file=$3
shift 3

# Shareable leases retain their named pipes until the final owner exits.
lease_dir=${control%/*}

# The caller opens the status reader nonblocking before connecting its writer.
# Only real lease writers keep control open; never add a dummy writer.
exec 0< "$control"
exec 1> "$status"

# The lock lives in this command until every inherited control writer closes.
# Keep stdout open for the caller to wait for release after closing its writer.
s6-setlock "$@" -d 3 "$lock_file" /bin/sh -c '
printf "0\n"
exec cat > /dev/null
'
result=$?
# s6-setlock has released the lock. Report before potentially slow cleanup.
printf '%s\n' "$result"
# On acquisition failure the caller still needs to read the error file.
if [ "$result" -eq 0 ]; then
    rm -rf "$lease_dir"
fi
